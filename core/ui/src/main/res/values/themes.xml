<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!-- the app draws its own light and dark appearance, android 10's force dark and MIUI's
       dark mode recolour only part of a compose screen, white text on a light background -->
  <style name="Theme.RecorderApp" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:forceDarkAllowed">false</item>
  </style>

  <style name="Theme.App.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/ios_splash_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    <item name="windowSplashScreenAnimationDuration">800</item>
    <item name="postSplashScreenTheme">@style/Theme.RecorderApp</item>
  </style>

</resources>